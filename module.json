        "id": "pf1e_compendium_chn",
        "type": "module",
        "reason": "合集包条目显示中文名；没装也能用（按英文名对上）。"
      },
      {
        "id": "pf-content",
        "type": "module",
        "reason": "补全专长、特性、魔法物品等合集包条目，更多条目可以拖进角色卡。"
      },
      {
        "id": "pf1-zh-monsters",
        "type": "module",
        "reason": "怪物 / NPC 页的条目可以拖进场景。"
      }
